<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyView" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/mv_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Shown while the app starts: dark background with the app icon, then switches to Theme.MyView. -->
    <style name="Theme.MyView.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF120A2B</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#FF120A2B</item>
        <item name="postSplashScreenTheme">@style/Theme.MyView</item>
    </style>
</resources>
