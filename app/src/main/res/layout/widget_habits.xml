<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/h_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Habits today"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/h_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/h_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/h_check1"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Toggle habit"
            android:src="@drawable/ic_widget_todo" />

        <TextView
            android:id="@+id/h_name1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/h_streak1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFF9A3D"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/h_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/h_check2"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Toggle habit"
            android:src="@drawable/ic_widget_todo" />

        <TextView
            android:id="@+id/h_name2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/h_streak2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFF9A3D"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/h_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/h_check3"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Toggle habit"
            android:src="@drawable/ic_widget_todo" />

        <TextView
            android:id="@+id/h_name3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/h_streak3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFF9A3D"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/h_row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/h_check4"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Toggle habit"
            android:src="@drawable/ic_widget_todo" />

        <TextView
            android:id="@+id/h_name4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/h_streak4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFF9A3D"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/h_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/h_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
