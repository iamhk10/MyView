<?xml version="1.0" encoding="utf-8"?>
<!-- Dark glass card: a violet-to-silver edge around a deep violet-black gradient. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#55B7BBD0"
                android:startColor="#889A6BFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="300"
                android:endColor="#F00A0812"
                android:startColor="#F2221A3E" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</layer-list>
